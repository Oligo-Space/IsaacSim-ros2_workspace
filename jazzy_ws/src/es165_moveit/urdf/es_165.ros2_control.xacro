<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="es165_ros2_control" params="name">
    <!-- ROS 2 control block -->
    <ros2_control name="es165_arm" type="system">

      <!-- Isaac Sim hardware interface -->
      <hardware>
        <!-- Using topic_based_ros2_control for Isaac Sim integration -->
        <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
        <param name="joint_commands_topic">isaac_joint_commands</param>
        <param name="joint_states_topic">isaac_joint_states</param>
        <!-- Negative threshold: always publish commands. The default 1e-5 deadband
             suppresses velocity commands together with position, leaving Isaac's
             articulation PD tracking a stale velocity target. -->
        <param name="trigger_joint_command_threshold">-1.0</param>
        <!-- Do NOT enable sum_wrapped_joint_states: this Isaac version publishes
             UNWRAPPED positions (observed beyond ±2pi), and the accumulator's
             swapped-limit bug aliases any >pi state jump by 2pi, making Isaac
             wind joints a full turn (seen as joint_4_r at -362.7deg + arm jiggle) -->
        <param name="sum_wrapped_joint_states">false</param>
      </hardware>

      <!-- Joint interfaces -->
      <joint name="joint_1_s">
        <command_interface name="position">
          <param name="initial_value">0.0</param>
        </command_interface>
        <command_interface name="velocity">
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>

      <joint name="joint_2_l">
        <command_interface name="position">
          <param name="initial_value">0.0</param>
        </command_interface>
        <command_interface name="velocity">
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>

      <joint name="joint_3_u">
        <command_interface name="position">
          <param name="initial_value">0.0</param>
        </command_interface>
        <command_interface name="velocity">
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>

      <joint name="joint_4_r">
        <command_interface name="position">
          <param name="initial_value">0.0</param>
        </command_interface>
        <command_interface name="velocity">
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>

      <joint name="joint_5_b">
        <command_interface name="position">
          <param name="initial_value">0.0</param>
        </command_interface>
        <command_interface name="velocity">
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>

      <joint name="joint_6_t">
        <command_interface name="position">
          <param name="initial_value">0.0</param>
        </command_interface>
        <command_interface name="velocity">
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
    
    </ros2_control>
  </xacro:macro>
</robot>
