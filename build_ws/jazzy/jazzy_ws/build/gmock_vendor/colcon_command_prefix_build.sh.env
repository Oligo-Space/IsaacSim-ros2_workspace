CMAKE_PREFIX_PATH=/workspace/jazzy_ws/install
COLCON=1
DEBIAN_FRONTEND=noninteractive
HOME=/root
LC_CTYPE=C.UTF-8
OLDPWD=/workspace
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
PKG_CONFIG_PATH=/workspace/jazzy_ws/install/lib/x86_64-linux-gnu/pkgconfig:/workspace/jazzy_ws/install/lib/pkgconfig
PWD=/workspace/jazzy_ws/build/gmock_vendor
PYTHONPATH=/workspace/jazzy_ws/install/lib/python3.12/site-packages
ROS_DISTRO=jazzy
ROS_PYTHON_VERSION=3
ROS_ROOT=jazzy_ws
